<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="OpenItemIcon" src="project://database/Assets/ClientUtils/UIManager/OpenItemIcon.uxml?fileID=9197481963319205126&amp;guid=73ced31bb6662984f8dbf2f0f4ea4cf3&amp;type=3#OpenItemIcon"/>
    <Style src="project://database/Assets/ClientUtils/UIManager/UIStyleSheet.uss?fileID=7433441132597879392&amp;guid=5dfc18a63d6253140bdb99a24ded5c29&amp;type=3#UIStyleSheet"/>
    <ui:VisualElement name="body" style="background-color: rgba(13, 12, 13, 0.94);">
        <ui:VisualElement class="tabs">
            <ui:Button text="Home" name="tab-home-button" class="tab tab-active"/>
            <ui:Button text="Social" name="tab-social-button" class="tab"/>
            <ui:Button text="Settings" name="tab-settings-button" class="tab"/>
            <ui:Button text="Dev" name="tab-dev-button" class="tab"/>
        </ui:VisualElement>
        <ui:VisualElement class="content">
            <ui:VisualElement name="home" style="display: none;">
                <ui:VisualElement name="VisualElement" class="center-area">
                    <ui:VisualElement class="world-info-section">
                        <ui:Image source="project://database/Assets/ClientUtils/UIManager/img/free-icon-village-2388458.png?fileID=2800000&amp;guid=08ceb19d24bc6d241a330101049c5202&amp;type=3#free-icon-village-2388458" name="world-pic"/>
                        <ui:VisualElement class="world-info-main">
                            <ui:Label name="world-title" text="World Title"/>
                            <ui:Label name="world-url" text="World URL"/>
                            <ui:VisualElement class="world-actions-bar" style="flex-grow: 1;">
                                <ui:Button name="world-bookmark-button" class="world-actions-button"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="main-input-wrapper">
                        <ui:TextField placeholder-text="https://" name="main-address-bar" enabled="true" is-delayed="true" hide-placeholder-on-focus="true"/>
                        <ui:Image source="project://database/Assets/ClientUtils/UIManager/img/free-icon-font-garage-6955578.svg?fileID=7388822144124034973&amp;guid=72d7c08359bdf8245863b1dbd28dc5c2&amp;type=3#free-icon-font-garage-6955578" tint-color="rgb(106, 106, 118)" style="position: absolute; left: 0; padding-left: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-bottom: 18px; padding-top: 16px; height: 100%; width: 52px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="sub-input-wrapper">
                        <ui:TextField placeholder-text="https://" name="sub-address-bar" enabled="true" is-delayed="true" hide-placeholder-on-focus="true"/>
                        <ui:Image source="project://database/Assets/ClientUtils/UIManager/img/free-icon-font-fish-5070389.svg?fileID=7388822144124034973&amp;guid=8a17c5429601a3c4a9a4f11344b12a1f&amp;type=3#free-icon-font-fish-5070389" tint-color="rgb(106, 106, 118)" style="position: absolute; left: 0; width: 40px; height: 100%; padding-left: 14px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-bottom: 12px; padding-top: 12px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="local-items-section">
                        <ui:Instance template="OpenItemIcon" name="OpenItemIcon" style="display: none;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="inventory">
                    <ui:Button class="inventory-item"/>
                    <ui:Button class="inventory-item"/>
                    <ui:Button class="inventory-item"/>
                    <ui:Button class="inventory-item"/>
                    <ui:Button class="inventory-item"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="social"/>
            <ui:VisualElement name="settings"/>
            <ui:VisualElement name="dev" style="display: flex;">
                <ui:VisualElement class="dev-left">
                    <ui:Label text="ID: " name="local-id" class="dev-label"/>
                    <ui:Label text="frame time not measured" name="frame-time" class="dev-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="dev-right">
                    <ui:ScrollView vertical-scroller-visibility="Hidden" class="log-scrol-view">
                        <ui:Label name="log"/>
                    </ui:ScrollView>
                    <ui:TextField name="console" label="&gt;&gt;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
